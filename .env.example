HOST=127.0.0.1
PORT=8787
DATA_FILE=./data/db.json
COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# Local demo mode returns a deterministic response without an upstream key.
DEMO_MODE=true
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
UPSTREAM_MODEL=deepseek-chat

# Set a long random value before exposing the service beyond localhost.
BACKEND_PEPPER=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
# Password-only gate for /admin. Use a separate random value in production.
ADMIN_PAGE_PASSWORD=change-this-admin-page-password
INVITATION_REQUIRED=false
REQUEST_TIMEOUT_MS=90000
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60
